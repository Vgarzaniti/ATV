# Spotify Developer App Credentials
# 1. Go to https://developer.spotify.com/dashboard and create an app.
# 2. In your Spotify App Settings, add this exact Redirect URI:
#    http://127.0.0.1:8888/callback
# 3. Copy your Client ID below (Client Secret is optional because ATV uses OAuth2 PKCE so any user can log in safely).

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional default Spotify Playlist URL or URI to load on startup
SPOTIFY_DEFAULT_PLAYLIST=

# DJ Engine Runtime Tuning
DJ_TARGET_ENERGY=0.85
DJ_CREATIVITY_TEMPERATURE=0.40
DJ_NETWORK_LATENCY_OFFSET_MS=250
DJ_POLL_INTERVAL_SEC=0.40
